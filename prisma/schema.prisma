generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                 @id @default(cuid())
  parentId            String?
  accountType         String                 @db.VarChar(20)
  email               String?                @unique @db.VarChar(255)
  phone               String?                @unique @db.VarChar(20)
  passwordHash        String                 @db.VarChar(255)
  username            String?                @unique @db.VarChar(100)
  firstLogin          Boolean                @default(true)
  isVerified          Boolean                @default(true)
  isActive            Boolean                @default(true)
  subscriptionId      String?
  subscriptionEndsAt  DateTime?
  createdBy           String?
  createdAt           DateTime               @default(now())
  lastLogin           DateTime?
  lastActive          DateTime?
  referralCode        String?                @unique @db.VarChar(20)
  referredBy          String?
  reportsSent         AccountReport[]        @relation("ReportsSent")
  reportsGenerated    AccountReport[]        @relation("ReportsGenerated")
  contentAttempts     ContentAttempt[]
  evaluationAttempts  EvaluationAttempt[]
  loginAttempts       LoginAttempt[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  profile             Profile?
  refreshTokens       RefreshToken[]
  sessions            Session[]
  subAccountControls  SubAccountControl[]    @relation("ParentControls")
  controlledByParent  SubAccountControl[]    @relation("SubAccountControlled")
  subscription        Subscription?
  transactions        Transaction[]
  paymentRequests     PaymentRequest[]
  badges              UserBadge[]
  certificates        UserCertificate[]
  dailyActivity       UserDailyActivity[]
  languageProgress    UserLanguageProgress[]
  levelProgress       UserLevelProgress[]
  moduleProgress      UserModuleProgress[]
  subThemeProgress    UserSubThemeProgress[]
  stats               UserStats?
  createdByUser       User?                  @relation("CreatedBy", fields: [createdBy], references: [id])
  createdUsers        User[]                 @relation("CreatedBy")
  parentUser          User?                  @relation("ParentToSubAccounts", fields: [parentId], references: [id])
  subAccounts         User[]                 @relation("ParentToSubAccounts")
  verificationCodes   VerificationCode[]
  sentMessages        Message[]              @relation("SentMessages")
  receivedMessages    Message[]              @relation("ReceivedMessages")
  deviceTokens        DeviceToken[]
  referralsSent       Referral[]             @relation("ReferralParrain")
  referralReceived    Referral?              @relation("ReferralFilleul")

  @@index([parentId])
  @@index([accountType])
  @@index([createdBy], map: "users_createdBy_fkey")
  @@map("users")
}

model Referral {
  id          String    @id @default(cuid())
  parrainId   String
  filleulId   String    @unique
  status      String    @default("pending") @db.VarChar(20) // pending | rewarded
  rewardedAt  DateTime?
  createdAt   DateTime  @default(now())
  parrain     User      @relation("ReferralParrain", fields: [parrainId], references: [id], onDelete: Cascade)
  filleul     User      @relation("ReferralFilleul", fields: [filleulId], references: [id], onDelete: Cascade)

  @@index([parrainId])
  @@map("referrals")
}

model Profile {
  id                String    @id @default(cuid())
  userId            String    @unique
  firstName         String    @db.VarChar(100)
  lastName          String    @db.VarChar(100)
  displayName       String?   @db.VarChar(100)
  birthDate         DateTime?
  avatarUrl         String?   @db.VarChar(500)
  timezone          String    @default("Europe/Paris") @db.VarChar(50)
  preferredLanguage String    @default("fr") @db.VarChar(10)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Language {
  id           String                 @id @default(cuid())
  code         String                 @unique @db.VarChar(10)
  name         String                 @db.VarChar(100)
  description  String?                @db.Text
  iconUrl      String?                @db.VarChar(500)
  isActive     Boolean                @default(true)
  index        Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  flagUrl      String?                @db.VarChar(500)
  certificates     Certificate[]
  levels           Level[]
  userProgress     UserLanguageProgress[]

  @@index([index])
  @@map("languages")
}

model Level {
  id           String              @id @default(cuid())
  languageId   String
  code         String              @db.VarChar(20)
  name         String              @db.VarChar(100)
  description  String?             @db.Text
  index        Int                 @default(0)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  language     Language            @relation(fields: [languageId], references: [id], onDelete: Cascade)
  modules      Module[]
  userProgress UserLevelProgress[]

  @@unique([languageId, code])
  @@unique([languageId, index])
  @@map("levels")
}

model Module {
  id           String               @id @default(cuid())
  levelId      String
  title        String               @db.VarChar(200)
  description  String?              @db.Text
  iconUrl      String?              @db.VarChar(500)
  index        Int                  @default(0)
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  thumbnailUrl String?              @db.VarChar(500)
  level        Level                @relation(fields: [levelId], references: [id], onDelete: Cascade)
  themes       Theme[]
  userProgress UserModuleProgress[]

  @@unique([levelId, index])
  @@map("modules")
}

model Theme {
  id          String     @id @default(cuid())
  moduleId    String
  title       String     @db.VarChar(200)
  description String?    @db.Text
  iconUrl     String?    @db.VarChar(500)
  index       Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  module      Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  subThemes   SubTheme[]

  @@index([moduleId])
  @@map("themes")
}

model SubTheme {
  id           String                 @id @default(cuid())
  themeId      String
  title        String                 @db.VarChar(200)
  description  String?                @db.Text
  index        Int                    @default(0)
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  theme        Theme                  @relation(fields: [themeId], references: [id], onDelete: Cascade)
  contents     Content[]
  evaluation   Evaluation?
  userProgress UserSubThemeProgress[]

  @@index([themeId])
  @@map("sub_themes")
}

// contentType: course | video | exercise | resource
model Content {
  id         String @id @default(cuid())
  subThemeId String
  contentType String @db.VarChar(20)
  title      String @db.VarChar(200)
  index      Int    @default(0)
  isActive   Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // ── course ──
  summary         String? @db.Text

  // ── video ──
  videoUrl        String? @db.VarChar(500)
  description     String? @db.Text
  keyPoints       Json?

  // ── exercise ──
  statement       String? @db.Text
  question        String? @db.Text
  possibleAnswers Json?
  correctAnswer   Json?
  explanation     String? @db.Text

  // ── resource ──
  resourceType String? @db.VarChar(20)
  resourceUrl  String? @db.VarChar(500)

  subTheme SubTheme       @relation(fields: [subThemeId], references: [id], onDelete: Cascade)
  blocks   ContentBlock[]
  attempts ContentAttempt[]

  @@unique([subThemeId, index])
  @@index([subThemeId, contentType])
  @@map("contents")
}

model ContentBlock {
  id          String   @id @default(cuid())
  contentId   String
  sectionType String   @db.VarChar(30)  // introduction | lesson | example | key_point | summary
  blockType   String   @db.VarChar(20)  // text | video | audio | pdf | image
  content     String   @db.Text         // texte brut OU url selon blockType
  caption     String?  @db.VarChar(500)
  index       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  parent      Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, index])
  @@map("content_blocks")
}

model Evaluation {
  id               String              @id @default(cuid())
  subThemeId       String              @unique
  title            String              @db.VarChar(200)
  description      String?             @db.Text
  questions        Json
  passingScore     Int                 @default(70)
  maxAttempts      Int                 @default(3)
  timeLimitMinutes Int?                @default(15)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  subTheme         SubTheme            @relation(fields: [subThemeId], references: [id], onDelete: Cascade)
  attempts         EvaluationAttempt[]

  @@map("evaluations")
}

model EvaluationAttempt {
  id               String     @id @default(cuid())
  userId           String
  evaluationId     String
  attemptNumber    Int
  answers          Json
  score            Decimal    @db.Decimal(5, 2)
  passed           Boolean
  timeSpentSeconds Int?
  feedback         Json?
  createdAt        DateTime   @default(now())
  evaluation       Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, evaluationId, attemptNumber])
  @@index([evaluationId], map: "evaluation_attempts_evaluationId_fkey")
  @@map("evaluation_attempts")
}

model ContentAttempt {
  id               String   @id @default(cuid())
  userId           String
  contentId        String
  attemptNumber    Int
  answers          Json
  score            Decimal? @db.Decimal(5, 2)
  isCorrect        Boolean?
  timeSpentSeconds Int?
  createdAt        DateTime @default(now())
  content          Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId, attemptNumber])
  @@index([contentId], map: "content_attempts_contentId_fkey")
  @@map("content_attempts")
}

model UserSubThemeProgress {
  id                  String    @id @default(cuid())
  userId              String
  subThemeId          String
  progressPercentage  Decimal   @default(0.00) @db.Decimal(5, 2)
  completedContentIds Json?
  evaluationScore     Decimal?  @db.Decimal(5, 2)
  startedAt           DateTime?
  completedAt         DateTime?
  lastAccessedAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  subTheme            SubTheme  @relation(fields: [subThemeId], references: [id], onDelete: Cascade)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subThemeId])
  @@index([subThemeId])
  @@index([userId])
  @@map("user_sub_theme_progress")
}

model UserLanguageProgress {
  id               String    @id @default(cuid())
  userId           String
  languageId       String
  status           String    @default("not_started") @db.VarChar(20)
  overallProgress  Decimal   @default(0.00) @db.Decimal(5, 2)
  totalXp          Int       @default(0)
  totalTimeMinutes Int       @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  lastAccessedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  language         Language  @relation(fields: [languageId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, languageId])
  @@index([languageId, status])
  @@index([userId, lastAccessedAt])
  @@map("user_language_progress")
}

model UserLevelProgress {
  id                 String    @id @default(cuid())
  userId             String
  levelId            String
  status             String    @default("locked") @db.VarChar(20)
  progressPercentage Decimal   @default(0.00) @db.Decimal(5, 2)
  totalXp            Int       @default(0)
  timeSpentMinutes   Int       @default(0)
  unlockedAt         DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  lastAccessedAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  level              Level     @relation(fields: [levelId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
  @@index([levelId, status])
  @@index([userId, status])
  @@map("user_level_progress")
}

model UserModuleProgress {
  id                 String    @id @default(cuid())
  userId             String
  moduleId           String
  status             String    @default("locked") @db.VarChar(20)
  progressPercentage Decimal   @default(0.00) @db.Decimal(5, 2)
  totalXp            Int       @default(0)
  timeSpentMinutes   Int       @default(0)
  unlockedAt         DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  lastAccessedAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  module             Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([moduleId, status])
  @@index([userId, status])
  @@map("user_module_progress")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @db.Text
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "refresh_tokens_userId_fkey")
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @db.Text
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "password_reset_tokens_userId_fkey")
  @@map("password_reset_tokens")
}

model VerificationCode {
  id           String   @id @default(cuid())
  userId       String?
  contactType  String
  contactValue String
  type         String
  isUsed       Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  attempts     Int      @default(0)
  codeHash     String   @db.VarChar(255)
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@map("verification_codes")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  phone     String?
  success   Boolean
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "login_attempts_userId_fkey")
  @@map("login_attempts")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  deviceInfo   Json?
  ipAddress    String?
  lastActivity DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_userId_fkey")
  @@map("sessions")
}

model SubAccountControl {
  id                     String   @id @default(cuid())
  parentUserId           String
  subAccountId           String
  dailyTimeLimitMinutes  Int      @default(120)
  weeklyTimeLimitMinutes Int      @default(840)
  bedtimeStart           String   @default("21:00") @db.VarChar(10)
  bedtimeEnd             String   @default("07:00") @db.VarChar(10)
  canPurchase            Boolean  @default(false)
  spendingLimitCoins     Int      @default(0)
  notificationsEnabled   Boolean  @default(true)
  progressReportsEnabled Boolean  @default(true)
  reportFrequency        String   @default("weekly") @db.VarChar(20)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  parentUser             User     @relation("ParentControls", fields: [parentUserId], references: [id], onDelete: Cascade)
  subAccount             User     @relation("SubAccountControlled", fields: [subAccountId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, subAccountId])
  @@index([subAccountId], map: "sub_account_controls_subAccountId_fkey")
  @@map("sub_account_controls")
}

model SubscriptionPlan {
  id             String         @id @default(cuid())
  planCode       String         @unique @db.VarChar(50)
  planName       String         @db.VarChar(100)
  description    String?        @db.Text
  priceMonthly   Decimal?       @db.Decimal(10, 2)
  priceYearly    Decimal?       @db.Decimal(10, 2)
  reducePrice    Decimal?       @db.Decimal(10, 2)
  percentage     Decimal?       @db.Decimal(5, 2)
  currency       String         @default("EUR") @db.VarChar(3)
  coinPrice      Int?
  features       Json
  maxSubAccounts Int            @default(0)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  subscriptions   Subscription[]
  paymentRequests PaymentRequest[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String           @id @default(cuid())
  userId             String           @unique
  planId             String
  status             String           @default("active") @db.VarChar(20)
  billingCycle       String           @default("monthly") @db.VarChar(20)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean          @default(false)
  canceledAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  plan               SubscriptionPlan @relation(fields: [planId], references: [id])
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([planId], map: "subscriptions_planId_fkey")
  @@map("subscriptions")
}

model Certificate {
  id               String            @id @default(cuid())
  languageId       String?
  certCode         String            @unique @db.VarChar(50)
  certName         String            @db.VarChar(200)
  description      String?           @db.Text
  iconUrl          String?           @db.VarChar(500)
  bannerUrl        String?           @db.VarChar(500)
  requirements     Json
  validityDays     Int?
  xpReward         Int               @default(500)
  coinReward       Int               @default(200)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  language         Language?         @relation(fields: [languageId], references: [id])
  userCertificates UserCertificate[]

  @@index([languageId], map: "certificates_languageId_fkey")
  @@map("certificates")
}

model UserCertificate {
  id                String      @id @default(cuid())
  userId            String
  certificateId     String
  certificateNumber String      @unique @db.VarChar(100)
  issueDate         DateTime
  expiryDate        DateTime?
  score             Decimal?    @db.Decimal(5, 2)
  status            String      @default("active") @db.VarChar(20)
  downloadUrl       String?     @db.VarChar(500)
  qrCodeUrl         String?     @db.VarChar(500)
  data              Json?
  createdAt         DateTime    @default(now())
  certificate       Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, certificateId])
  @@index([certificateId], map: "user_certificates_certificateId_fkey")
  @@map("user_certificates")
}

model Badge {
  id          String      @id @default(cuid())
  badgeCode   String      @unique @db.VarChar(50)
  badgeName   String      @db.VarChar(100)
  description String?     @db.Text
  category    String?     @db.VarChar(30)
  iconUrl     String?     @db.VarChar(500)
  colorCode   String?     @db.VarChar(7)
  rarity      String      @default("common") @db.VarChar(20)
  criteria    Json
  xpReward    Int         @default(50)
  coinReward  Int         @default(100)
  isSecret    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  userBadges  UserBadge[]

  @@map("badges")
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([badgeId], map: "user_badges_badgeId_fkey")
  @@map("user_badges")
}

model UserStats {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  totalXp                 BigInt   @default(0)
  totalCoins              Int      @default(0)
  currentStreak           Int      @default(0)
  longestStreak           Int      @default(0)
  totalStudyMinutes       Int      @default(0)
  totalExercisesCompleted Int      @default(0)
  totalLessonsCompleted   Int      @default(0)
  totalStepsCompleted     Int      @default(0)
  totalLevelsCompleted    Int      @default(0)
  totalCertificatesEarned Int      @default(0)
  totalBadgesEarned       Int      @default(0)
  accuracyRate            Decimal? @db.Decimal(5, 2)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model UserDailyActivity {
  id                 String    @id @default(cuid())
  userId             String
  activityDate       DateTime
  studyMinutes       Int       @default(0)
  lessonsCompleted   Int       @default(0)
  exercisesCompleted Int       @default(0)
  stepsCompleted     Int       @default(0)
  xpEarned           Int       @default(0)
  coinsEarned        Int       @default(0)
  badgesEarned       Int       @default(0)
  streakMaintained   Boolean?
  firstActivityAt    DateTime?
  lastActivityAt     DateTime?
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityDate])
  @@map("user_daily_activity")
}

model AccountReport {
  id                  String    @id @default(cuid())
  parentUserId        String
  subAccountId        String
  reportType          String    @default("weekly") @db.VarChar(30)
  periodStart         DateTime
  periodEnd           DateTime
  summary             Json
  achievements        Json?
  areasForImprovement Json?
  recommendations     Json?
  totalStudyMinutes   Int?
  lessonsCompleted    Int?
  exercisesCompleted  Int?
  stepsCompleted      Int?
  levelsCompleted     Int?
  xpEarned            Int?
  coinsEarned         Int?
  badgesEarned        Int?
  certificatesEarned  Int?
  isViewed            Boolean   @default(false)
  viewedAt            DateTime?
  generatedAt         DateTime  @default(now())
  createdAt           DateTime  @default(now())
  parentUser          User      @relation("ReportsSent", fields: [parentUserId], references: [id], onDelete: Cascade)
  subAccount          User      @relation("ReportsGenerated", fields: [subAccountId], references: [id], onDelete: Cascade)

  @@index([parentUserId, periodStart, periodEnd])
  @@index([subAccountId], map: "account_reports_subAccountId_fkey")
  @@map("account_reports")
}

model Notification {
  id               String    @id @default(cuid())
  userId           String
  notificationType String?   @db.VarChar(30)
  title            String    @db.VarChar(200)
  message          String    @db.Text
  iconUrl          String?   @db.VarChar(500)
  actionUrl        String?   @db.VarChar(500)
  isRead           Boolean   @default(false)
  readAt           DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "notifications_userId_fkey")
  @@map("notifications")
}

model Transaction {
  id                String   @id @default(cuid())
  userId            String
  transactionType   String   @db.VarChar(30)
  amount            Decimal? @db.Decimal(10, 2)
  currency          String   @default("XOF") @db.VarChar(3)
  amountCoins       Int?
  description       String?  @db.VarChar(500)
  referenceType     String?  @db.VarChar(50)
  referenceId       String?
  balanceCoinsAfter Int?
  metadata          Json?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("transactions")
}

// ==================== DISCOVER ====================

model DiscoverSection {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(200)
  type      String   @db.VarChar(20)  // lesson | exercise
  language  String   @db.VarChar(100) // texte libre : "Français", "Wolof", etc.
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contents DiscoverContent[]

  @@map("discover_sections")
}

model DiscoverContent {
  id        String @id @default(cuid())
  sectionId String
  order     Int    @default(0)

  // Question
  questionType  String  @db.VarChar(20) // text | audio | image | video | file
  questionValue String  @db.Text

  // Answer — pour les sections de type lesson
  answerType  String? @db.VarChar(20)
  answerValue String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section DiscoverSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  options DiscoverOption[]

  @@index([sectionId])
  @@map("discover_contents")
}

model DiscoverOption {
  id        String  @id @default(cuid())
  contentId String
  value     String  @db.VarChar(500)
  isCorrect Boolean @default(false)
  order     Int     @default(0)

  content DiscoverContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@map("discover_options")
}

// ==================== MESSAGERIE ====================

model Message {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  content     String    @db.Text
  type        String    @default("text") @db.VarChar(20)
  metadata    Json?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User      @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId])
  @@index([recipientId, isRead])
  @@map("messages")
}

// ==================== DEVICE TOKENS (Push FCM) ====================

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @db.VarChar(500)
  platform  String   @default("android") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
  @@map("device_tokens")
}

// ==================== PAIEMENT ====================

model PaymentRequest {
  id            String    @id @default(cuid())
  userId        String
  planId        String
  billingCycle  String    @default("monthly") @db.VarChar(20)
  paymentMethod String    @db.VarChar(30)
  phoneNumber   String    @db.VarChar(20)
  amount        Decimal   @db.Decimal(10, 2)
  currency      String    @default("XOF") @db.VarChar(3)
  otpCode       String?   @db.VarChar(10)
  providerRef   String?   @db.VarChar(255)
  otpExpiresAt  DateTime?
  otpVerified   Boolean   @default(false)
  status        String    @default("pending") @db.VarChar(20)
  failureReason String?   @db.VarChar(255)
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@index([planId])
  @@map("payment_requests")
}

// ==================== PARAMÈTRES GLOBAUX ====================

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(100)
  value     String   @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

